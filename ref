
CREATE TABLE Bnk_details (
    b_sno INT AUTO_INCREMENT PRIMARY KEY,
    b_name VARCHAR(255),
    b_cust_id VARCHAR(255),
    b_acc_name VARCHAR(255),
    b_card_num VARCHAR(255),
    b_cpin VARCHAR(255),
    b_psw VARCHAR(255),
    b_profile_password VARCHAR(255),
    b_created_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    b_updated DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE AndroidSkillMaster (
    asm_sno INT AUTO_INCREMENT PRIMARY KEY,
    asm_id INT NOT NULL DEFAULT 0,
    asm_name VARCHAR(255) NOT NULL,
    asm_tag VARCHAR(100),

    asm_created_date DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    asm_updated DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);


CREATE TABLE selfImprovement (
    ai_sno INT AUTO_INCREMENT PRIMARY KEY,
    ai_name VARCHAR(255) NOT NULL,
    ai_created_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    ai_updated DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);






